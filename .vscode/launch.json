{
  // F5 sobe o app na porta 3002. A porta é fixa de propósito: 3000 e 3001 estão ocupadas por
  // processos de outra máquina/usuário neste ambiente, e cair nelas significa falar com o app
  // errado — foi o que produziu o `Unable to exchange external code` da task 9.4. Para trocar,
  // altere o valor abaixo (e a mesma origem precisa estar acessível no painel do Supabase).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev: app (3002)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3002"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Ready in|- Local:",
        "uriFormat": "%s/login"
      }
    },
    {
      "name": "test: watch (vitest)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run test:watch",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "typecheck",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run typecheck",
      "cwd": "${workspaceFolder}"
    }
  ]
}
