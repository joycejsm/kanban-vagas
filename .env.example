# URL pública do projeto Supabase. Não é segredo: pode ir em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon/publishable. Protegida por RLS: sozinha ela não acessa nada de outro usuário.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_TOKEN_ANON

# NÃO defina nem use uma service role key aqui.
# A service role ignora RLS e nunca é usada em fluxo disparado por usuário (invariante 2).
# Se precisar de acesso administrativo pontual, use `supabase secrets set` e um job
# explícito, nunca o caminho de uma requisição do app.
