# URL pública do projeto Supabase. Não é segredo: pode ir em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave anon/publishable. Protegida por RLS: sozinha ela não acessa nada de outro usuário.
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_TOKEN_ANON

# As duas variáveis acima são as ÚNICAS `NEXT_PUBLIC_*` que o app Next.js lê. Se qualquer
# uma faltar, o servidor de desenvolvimento recusa subir e diz qual está faltando
# (src/instrumentation.ts); em produção a rota `/` responde 500 com a mesma mensagem.

# E-mails autorizados a usar o app. Variável de SERVIDOR, e não NEXT_PUBLIC_*: a lista de
# quem tem acesso é segredo do dono do app, e publicá-la transformaria a página numa
# listagem de quem pode entrar. Lista separada por vírgula; a comparação ignora caixa e
# espaços nas pontas, então "Bruno@Exemplo.com" e "bruno@exemplo.com" são o mesmo endereço.
#
# Esta lista é o ESPELHO da tabela public.allowed_emails do banco, que é a fonte do hook
# "Before User Created". As duas precisam ter exatamente o mesmo conteúdo — quem decide o
# acesso é esta variável, e o banco nunca amplia o que ela diz (ver README, "Acesso por
# allowlist"). Para gerar o valor a partir do banco:
#
#   psql "$DB_URL" -c "select string_agg(email, ',' order by email) from public.allowed_emails"
#
# Sem valor real aqui: este arquivo é versionado.
ALLOWED_EMAILS=SEU_EMAIL_AQUI

# NÃO defina nem use uma service role key aqui.
# A service role ignora RLS e nunca é usada em fluxo disparado por usuário (invariante 2).
# Se precisar de acesso administrativo pontual, use `supabase secrets set` e um job
# explícito, nunca o caminho de uma requisição do app.
#
# As secrets da Edge Function NÃO pertencem a este arquivo: chave e modelo de LLM, e a
# `APP_ORIGIN`, vão para `supabase secrets set` e nunca para o ambiente do Next. O README
# ("Fluxo de segredos") lista quais são cada uma e por quê.
